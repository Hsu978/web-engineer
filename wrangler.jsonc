{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-engineer",
  "compatibility_date": "2026-09-03",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "web-engineer"
    }
  ]
}
